{
  "//": "Example MCP client config for trader-mcp. Copy the 'trader-mcp' block into your client's MCP config (.mcp.json for Claude Code, ~/.cursor/mcp.json for Cursor, ~/.codex/config.toml [mcp_servers] for Codex). uvx fetches and runs the published package; no manual install needed. Do NOT commit real API keys; prefer .env / OS keyring over inlining secrets here. Live trading is gated and disabled by default.",
  "mcpServers": {
    "trader-mcp": {
      "command": "uvx",
      "args": ["trader-mcp"],
      "env": {
        "TRADER_MCP_LOG_LEVEL": "INFO",
        "TRADER_MCP_DEFAULT_EXCHANGE": "coinbase"
      }
    },
    "trader-mcp-local": {
      "//": "Run from a local checkout instead of the published package.",
      "command": "uvx",
      "args": ["--from", "/absolute/path/to/trader-mcp", "trader-mcp"],
      "env": {
        "TRADER_MCP_LOG_LEVEL": "DEBUG"
      }
    }
  }
}
