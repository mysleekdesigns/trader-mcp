# trader-mcp — example environment file.
#
# Copy to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit a real .env or real API keys. trader-mcp never logs secret values.
# Configuration precedence: process environment > .env > OS keyring.

# ─────────────────────────────────────────────────────────────
# Server settings  (prefix: TRADER_MCP_)
# ─────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
TRADER_MCP_LOG_LEVEL=INFO

# Default exchange when a tool call omits one: bybit | blofin | toobit | weex
TRADER_MCP_DEFAULT_EXCHANGE=bybit

# ─────────────────────────────────────────────────────────────
# Exchange API credentials  (OPTIONAL — read-only keys recommended in v1)
# Per-exchange, prefixed by the uppercased CCXT id. Leave blank if unused.
# Use READ-ONLY keys; trade-enabled keys are only needed for later phases.
# ─────────────────────────────────────────────────────────────

# Bybit (reference exchange, validated first)
BYBIT_API_KEY=your-bybit-read-only-key
BYBIT_API_SECRET=your-bybit-read-only-secret

# BloFin
BLOFIN_API_KEY=your-blofin-read-only-key
BLOFIN_API_SECRET=your-blofin-read-only-secret

# Toobit
TOOBIT_API_KEY=your-toobit-read-only-key
TOOBIT_API_SECRET=your-toobit-read-only-secret

# WeeX
WEEX_API_KEY=your-weex-read-only-key
WEEX_API_SECRET=your-weex-read-only-secret
